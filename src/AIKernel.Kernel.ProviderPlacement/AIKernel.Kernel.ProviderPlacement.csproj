<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageVersion>0.1.4</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>aikernel-logo128x128.png</PackageIcon>
    <Description>AIKernel v1 provider placement scheduler and deterministic score validation.</Description>
    <PackageReleaseNotes>First provider placement scheduler for AIKernel 0.1.4 applications.</PackageReleaseNotes>
    <PackageTags>aikernel;kernel;provider;placement</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIKernel.Contracts.ProviderPlacement" Version="[0.1.4]" />
    <PackageReference Include="AIKernel.Kernel" Version="[0.1.4]" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/aikernel-logo128x128.png" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
