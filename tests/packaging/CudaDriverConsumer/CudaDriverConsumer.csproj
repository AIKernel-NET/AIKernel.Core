<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CudaKernelPackageVersion Condition="'$(CudaKernelPackageVersion)' == ''">$(StablePackageVersion)</CudaKernelPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Intentionally no ProjectReference: this verifies NuGet runtime asset resolution. -->
    <PackageReference Include="AIKernel.Kernel" Version="[$(CudaKernelPackageVersion)]" />
  </ItemGroup>
</Project>
