<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Include="..\..\assets\aikernel-logo128x128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\assets\aikernel-logo.png">
      <Pack>True</Pack>
      <PackagePath>assets\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIKernel.Core\AIKernel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Abstractions" Version="$(AIKernelContractPackageVersion)" />
    <PackageReference Include="AIKernel.Dtos" Version="$(AIKernelContractPackageVersion)" />
    <PackageReference Include="AIKernel.Enums" Version="$(AIKernelContractPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Description>EN: Kernel facade and orchestration layer for AIKernel.NET. Coordinates Core, Providers, Context, Governance, and execution flow through a unified IKernel interface.

JA: AIKernel.NET の Kernel Facade およびオーケストレーション層です。Core、Provider、Context、Governance、実行フローを統合された IKernel インターフェースで制御します。</Description>
    <Title>AIKernel.Kernel</Title>
    <PackageIcon>aikernel-logo128x128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Inference/Shaders/quantized_gemv.spv" />
    <EmbeddedResource Include="Inference/Shaders/quantized_gemv_subgroup.spv" />
  </ItemGroup>

  <!-- Release staging supplies binaries built from the same pinned Core source.
       CPU-only source builds remain possible without an NVIDIA driver or compiler. -->
  <PropertyGroup>
    <AIKernelRequireCudaAssets Condition="'$(PackageVersion)' == '0.1.4'">true</AIKernelRequireCudaAssets>
    <AIKernelRequireCpuAssets Condition="'$(PackageVersion)' == '0.1.4'">true</AIKernelRequireCpuAssets>
  </PropertyGroup>
  <Import Project="../../build/CudaNativePackaging.targets" />
  <ItemGroup Condition="'$(AIKernelCpuNativeRoot)' != ''">
    <None Include="$(AIKernelCpuNativeRoot)/win-x64/aikernel_cpu_accel.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(AIKernelCpuNativeRoot)/linux-x64/libaikernel_cpu_accel.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
  </ItemGroup>
  <Target Name="ValidateCpuReleaseAssets" BeforeTargets="GenerateNuspec" Condition="'$(AIKernelRequireCpuAssets)' == 'true'">
    <Error Condition="!Exists('$(AIKernelCpuNativeRoot)/win-x64/aikernel_cpu_accel.dll')" Text="The release requires the matching Windows VNNI/AMX binary." />
    <Error Condition="!Exists('$(AIKernelCpuNativeRoot)/linux-x64/libaikernel_cpu_accel.so')" Text="The release requires the matching Linux VNNI/AMX binary." />
  </Target>

</Project>
