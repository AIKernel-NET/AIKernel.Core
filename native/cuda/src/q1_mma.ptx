// SM80+ integer Tensor Core path. Each warp handles 16 output rows.
// B repeats the GEMV vector over 8 columns; only column zero is stored.
// Fragment mapping: NVIDIA PTX ISA, Matrix Fragments for mma.m16n8k32.
.version 7.0
.target sm_80
.address_size 64
.visible .entry matvec_q1_q8_mma(
 .param .u64 weights, .param .u64 input, .param .u64 scales, .param .u64 sums,
 .param .u64 output, .param .u32 rows, .param .u32 columns)
{
 .reg .pred %p<8>;
 .reg .b16 %h<2>;
 .reg .b32 %r<40>;
 .reg .b64 %d<24>;
 .reg .f32 %f<10>;
 ld.param.u64 %d0,[weights]; ld.param.u64 %d1,[input];
 ld.param.u64 %d2,[scales]; ld.param.u64 %d3,[sums]; ld.param.u64 %d4,[output];
 ld.param.u32 %r0,[rows]; ld.param.u32 %r1,[columns];
 mov.u32 %r2,%laneid; shr.u32 %r3,%r2,2; and.b32 %r4,%r2,3;
 mov.u32 %r5,%ctaid.x; mad.lo.u32 %r6,%r5,16,%r3; add.u32 %r7,%r6,8;
 setp.lt.u32 %p0,%r6,%r0; setp.lt.u32 %p1,%r7,%r0;
